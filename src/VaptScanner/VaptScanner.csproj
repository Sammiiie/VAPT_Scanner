<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Builds on .NET 8 and runs on any newer runtime (9, 10, ...). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>vapt</AssemblyName>
    <RootNamespace>VaptScanner</RootNamespace>
    <Version>1.0.0</Version>

    <!-- Install as a global/local dotnet tool: dotnet pack, then dotnet tool install -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vapt</ToolCommandName>
    <PackageId>VaptScanner</PackageId>
    <Description>Pre-production security scanner for .NET codebases: SAST rules, secret detection, config review, vulnerable NuGet audit and a safe DAST baseline scan.</Description>
    <Authors>Samuel Ejiga</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sammiiie/VAPT_Scanner</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sammiiie/VAPT_Scanner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet security sast owasp devsecops dast secrets sarif vapt</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
